{
  "name": "text-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Modular WYSIWYG rich-text editor library (opt-in extensions)",
  "workspaces": [
    "packages/*",
    "packages/extensions/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @editor/playground",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "lucide-static": "^1.55.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
